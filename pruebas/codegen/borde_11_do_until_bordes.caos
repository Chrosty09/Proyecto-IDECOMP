// Caso de borde de generación TM. No modifica el compilador.
main {
  int a, b, s, i, j;
  a = 3;
  do
    a = a + 1;
  until (a > 0);
  b = 0;
  do
    b = b + 1;
  until (b == 3);
  s = 0;
  i = 0;
  do
    j = 0;
    while (j < 2) {
      s = s + 1;
      j = j + 1;
    }
    i = i + 1;
  until (i == 2);
  cout a;
  cout b;
  cout s;
}
